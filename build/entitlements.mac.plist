<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Electron's V8 JIT and heap -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Required so macOS allows the Electron Framework (signed by GitHub) to load
       alongside app code signed by the developer certificate. Without this the
       hardened runtime rejects the bundled dylibs and the app crashes on launch. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Bluetooth access — required for caBLE / cross-device passkey ceremonies
       (Chromium FIDO uses BLE to connect to a phone authenticator). The matching
       NSBluetoothAlwaysUsageDescription / NSBluetoothPeripheralUsageDescription
       Info.plist keys are injected by Electron's framework defaults. Has no effect
       on unsigned builds — entitlements only take effect once the binary is signed
       with a Developer ID Application certificate. See docs/GOTCHAS.md. -->
  <key>com.apple.security.device.bluetooth</key>
  <true/>
</dict>
</plist>
