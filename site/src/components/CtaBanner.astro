---
import DownloadButton from './DownloadButton.astro';
import ProviderDots from './ProviderDots.astro';
import { SITE } from '@/lib/site';
import type { LatestRelease } from '@/lib/releases.types';

interface Props {
  release: LatestRelease;
}
const { release } = Astro.props;
---
<section class="cta">
  <div class="container container--narrow cta__inner">
    <ProviderDots size="lg" animate />
    <h2 class="cta__title">Stop juggling tabs.</h2>
    <p class="cta__sub">Six providers · one window · no telemetry · open source. Free, forever.</p>
    <div class="cta__buttons">
      <DownloadButton release={release} />
      <a class="btn btn--secondary" href={SITE.repo} target="_blank" rel="noopener">GitHub ↗</a>
    </div>
  </div>
</section>

<style>
  .cta {
    text-align: center;
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--accent) 6%, transparent));
    border-top: 1px solid var(--border);
  }
  .cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .cta__title { margin-top: var(--space-4); }
  .cta__sub { color: var(--text-muted); max-width: 44ch; }
  .cta__buttons {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-4);
  }
</style>
