---
import FeatureCard from './FeatureCard.astro';
import features from '@/content/features.json';
---
<section id="features" class="features">
  <div class="container">
    <header class="features__header">
      <h2 class="features__heading">
        Native is the point.
      </h2>
      <p class="features__lede">
        Mailwing doesn't reinvent your inbox. It loads each provider's real web
        interface — the exact Gmail or Outlook you already know — and gives all
        six one shared native window, with a few quiet upgrades a browser tab
        can't.
      </p>
    </header>
    <div class="features__grid">
      {features.map((f) => (
        <FeatureCard title={f.title} body={f.body} icon={f.icon} />
      ))}
    </div>
  </div>
</section>

<style>
  .features__header {
    max-width: 640px;
    margin-bottom: var(--space-12);
  }
  .features__lede {
    color: var(--text-muted);
    font-size: 17px;
    margin: var(--space-4) 0 0;
  }
  .features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .features__grid { grid-template-columns: 1fr 1fr; gap: var(--space-6); }
  }
  @media (min-width: 960px) {
    .features__grid { grid-template-columns: 1fr 1fr 1fr; }
  }
</style>
