---
import { PROVIDERS, PROVIDER_ARIA_LABEL } from '@/lib/providers';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  animate?: boolean;
}
const { size = 'md', animate = false } = Astro.props;

const sizeMap = { sm: 8, md: 12, lg: 16 } as const;
const gapMap  = { sm: 8, md: 12, lg: 14 } as const;
const dotPx = sizeMap[size];
const gapPx = gapMap[size];
---
<span
  class={`provider-dots ${animate ? 'provider-dots--animate' : ''}`}
  role="img"
  aria-label={PROVIDER_ARIA_LABEL}
  style={`--dot-size:${dotPx}px;--dot-gap:${gapPx}px;`}
>
  {PROVIDERS.map((p, i) => (
    <span
      class="provider-dot"
      data-provider={p.id}
      title={p.label}
      style={`--dot-color:${p.color};--dot-delay:${i * 0.2}s;`}
    />
  ))}
</span>

<style>
  .provider-dots {
    display: inline-flex;
    align-items: center;
    gap: var(--dot-gap, 12px);
  }
  .provider-dot {
    width: var(--dot-size, 12px);
    height: var(--dot-size, 12px);
    border-radius: 50%;
    background: var(--dot-color);
    outline: 1px solid color-mix(in srgb, var(--dot-color) 40%, transparent);
    outline-offset: 1px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  .provider-dots--animate .provider-dot {
    animation: dot-pulse 2.4s ease-in-out infinite;
    animation-delay: var(--dot-delay, 0s);
  }
</style>
