---
import DownloadPageLayout from '@/layouts/DownloadPageLayout.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import { getLatestRelease } from '@/lib/releases';
import { SITE } from '@/lib/site';

const release = await getLatestRelease();
const xattr = `xattr -dr com.apple.quarantine /Applications/Mailwing.app`;
const brew  = `brew install --cask ${SITE.brewTap}`;
---
<DownloadPageLayout os="mac" osLabel="macOS" release={release}>
  <h2>System requirements</h2>
  <ul>
    <li>macOS 11 Big Sur or later</li>
    <li>Universal binary — runs natively on Intel and Apple Silicon</li>
    <li>~250 MB free disk space</li>
  </ul>

  <h2>Install</h2>
  <ol>
    <li>Click <strong>Download</strong> above to grab the DMG.</li>
    <li>Open the DMG and drag <strong>Mailwing</strong> to <code>/Applications</code>.</li>
    <li>Double-click to open — that's it.</li>
  </ol>

  <h2 id="signing">Signed &amp; notarized</h2>
  <p>
    Mailwing is signed with an Apple Developer ID certificate and notarized by Apple, so
    macOS opens it with a normal double-click — no right-click, no Gatekeeper override.
    Every build is produced in the open by
    <a href="https://github.com/vinaysamtani/mailwing/actions" target="_blank" rel="noopener">GitHub Actions</a>,
    so you can audit exactly what shipped.
  </p>

  <h2>Install via Homebrew</h2>
  <p>If you prefer a single command, the Homebrew cask handles download and placement for you:</p>
  <CodeBlock code={brew} label="terminal" />

  <h2>Make Mailwing your default mail client</h2>
  <p>
    Open Mailwing → menu bar <strong>Mailwing → Set as default mail client</strong>. Or via
    System Settings → <strong>Default Web Browser</strong> (for mailto: links).
  </p>

  <h2>Troubleshooting</h2>
  <h3>"Mailwing is damaged and can't be opened"</h3>
  <p>Almost always a corrupted download — re-download the DMG. If it persists, clear the quarantine flag:</p>
  <CodeBlock code={xattr} label="terminal" />
  <h3>App quits immediately on first launch</h3>
  <p>Open <strong>Console.app</strong>, filter for <code>Mailwing</code>, then try to launch again. If you see a useful stack trace, please <a href={SITE.issues} target="_blank" rel="noopener">open an issue</a> with the log.</p>
  <h3>How do I uninstall?</h3>
  <p>Drag <code>/Applications/Mailwing.app</code> to the Trash, then remove the user-data directory at <code>~/Library/Application Support/mailwing</code> if you also want to clear accounts and notes.</p>
</DownloadPageLayout>
